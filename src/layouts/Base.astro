---
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/ms-madi/400.css';
import '@fontsource/architects-daughter/400.css';
import '../styles/global.css';
import { config } from '../config';
// Fontes da abertura: pré-carregadas para o título já surgir na fonte certa (sem salto de layout).
import fonteTitulo from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-400-normal.woff2?url';
import fonteTituloItalico from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-italic.woff2?url';
import fonteAssinatura from '@fontsource/ms-madi/files/ms-madi-latin-400-normal.woff2?url';
import fonteRotulos from '@fontsource/architects-daughter/files/architects-daughter-latin-400-normal.woff2?url';
const fontesAbertura = [fonteTitulo, fonteTituloItalico, fonteAssinatura, fonteRotulos];

interface Props { titulo?: string }
const { titulo = 'ESMERO por Juliana Corrêa' } = Astro.props;
const descricao = 'ESMERO, por Juliana Corrêa: arranjos florais autorais e consultoria de interiores para o bem-viver. Exclusivo em Belém do Pará.';
// Redes sociais exigem URL absoluta na prévia; ela só existe quando `site` estiver definido em astro.config.mjs.
const absoluta = (caminho: string) => (Astro.site ? new URL(caminho, Astro.site).href : caminho);
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  <meta name="theme-color" content="#F3EDE2" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:image" content={absoluta('/fotos/colecao-mesa.jpg')} />
  <meta property="og:image:width" content="800" />
  <meta property="og:image:height" content="600" />
  <meta property="og:image:alt" content="Arranjos da primeira coleção sobre a mesa: girassóis, antirrinos rosa e eucalipto" />
  <meta property="og:locale" content="pt_BR" />
  {Astro.site && <meta property="og:url" content={absoluta(Astro.url.pathname)} />}
  {Astro.site && <link rel="canonical" href={absoluta(Astro.url.pathname)} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {fontesAbertura.map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  <link rel="preload" as="image" href="/aquarela/ceu.webp" fetchpriority="high" />
  <link rel="preload" as="image" href="/aquarela/mascara-1.webp" crossorigin />
  <link rel="preload" as="image" href="/aquarela/mascara-2.webp" crossorigin />
  <link rel="preload" as="image" href="/aquarela/mascara-3.webp" crossorigin />
  <link rel="preload" as="image" href="/aquarela/papel.webp" />
  <!-- Esconde o estado final da abertura até a animação de entrada começar (evita "piscar").
       Garantia: se o script principal não rodar em 6 s, mostra tudo como está. -->
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('intro');
      setTimeout(function () { if (!window.__esmero) document.documentElement.classList.remove('intro'); }, 6000);
    }
  </script>
</head>
<body>
  <div id="root" data-movimento={config.movimento}>
    <svg width="0" height="0" aria-hidden="true" style="position:absolute">
      <defs>
        <filter id="ink" filterUnits="userSpaceOnUse" x="-2000" y="-2000" width="8000" height="8000"><feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="4"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="3.2"></feDisplacementMap></filter>
        <filter id="rough" filterUnits="userSpaceOnUse" x="-2000" y="-2000" width="8000" height="8000"><feTurbulence type="fractalNoise" baseFrequency="0.012 0.09" numOctaves="3" seed="11"></feTurbulence><feDisplacementMap in="SourceGraphic" scale="14"></feDisplacementMap></filter>
      </defs>
    </svg>
    <slot />
  </div>
  <script>
    import { iniciar } from '../scripts/motion';
    iniciar(document.getElementById('root')!);
  </script>
</body>
</html>
