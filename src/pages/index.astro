---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Petalas from '../components/Petalas.astro';
import BotaoFlutuante from '../components/BotaoFlutuante.astro';
import Abertura from '../components/Abertura.astro';
import Arranjos from '../components/Arranjos.astro';
import Pergunta from '../components/Pergunta.astro';
import Manifesto from '../components/Manifesto.astro';
import Faixa from '../components/Faixa.astro';
import Consultoria from '../components/Consultoria.astro';
import Licoes from '../components/Licoes.astro';
import Juliana from '../components/Juliana.astro';
import Fecho from '../components/Fecho.astro';
import Rodape from '../components/Rodape.astro';
import { config } from '../config';
---
<Base>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <Cabecalho />
  {config.petalas && <Petalas />}
  <BotaoFlutuante />
  <main id="conteudo" tabindex="-1">
    <Abertura />
    <Arranjos />
    <Pergunta />
    <Manifesto />
    <Faixa />
    <Consultoria />
    <Licoes />
    <Juliana />
    <Fecho />
  </main>
  <Rodape />
</Base>
