---
import Base from '../layouts/Base.astro';
import Contorno from '../components/ui/Contorno.astro';
---
<Base titulo="Página não encontrada · ESMERO por Juliana Corrêa">
  <main style="min-height:100svh;box-sizing:border-box;display:grid;place-items:center;padding:clamp(40px,8vw,120px) clamp(20px,5vw,72px);text-align:center">
    <div>
      <a href="/" style="display:inline-flex;align-items:center;gap:clamp(10px,1.2vw,16px);text-decoration:none;color:#1F1A17">
        <span style="font-family:'Ms Madi',cursive;font-size:clamp(34px,3.4vw,52px);line-height:1;white-space:nowrap">Por Juliana Corrêa</span>
        <span style="width:1.5px;height:clamp(30px,3vw,44px);background:#1F1A17;flex:none"></span>
        <span style="font-weight:700;letter-spacing:.02em;font-size:clamp(22px,2.2vw,32px)">ESMERO</span>
      </a>
      <h1 style="margin:clamp(40px,6vw,80px) 0 clamp(32px,4vw,52px);font-weight:300;font-style:italic;font-size:clamp(44px,6vw,96px);line-height:.95;letter-spacing:-.022em;color:#B8195A">Página não encontrada.</h1>
      <a class="hv-1" href="/" data-paint="" style="position:relative;display:inline-flex;align-items:center;gap:12px;padding:15px 26px;font-family:'Architects Daughter',cursive;font-size:14px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;color:#1F1A17;isolation:isolate;transition:letter-spacing .8s cubic-bezier(.2,.7,.2,1)"><span class="paint-ink" aria-hidden="true"><i></i><i></i><i></i></span>Voltar ao início<Contorno /></a>
    </div>
  </main>
</Base>
