---
import CartaoLicao from './CartaoLicao.astro';
import { licoes } from '../data/licoes';
---
<section id="licoes" aria-labelledby="h-lic" style="padding:clamp(60px,8vw,120px) clamp(20px,5vw,72px) clamp(30px,4vw,50px);scroll-margin-top:40px">
  <div style="max-width:1300px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(28px,5vw,90px);align-items:flex-end">
    <div data-r="" style="flex:1 1 440px;opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 50px))">
      <p style="margin:0 0 1.2em;font-family:'Architects Daughter',cursive;font-size:13px;letter-spacing:.14em;text-transform:uppercase">ESMERO por Juliana Corrêa</p>
      <h2 id="h-lic" style="margin:0;font-weight:400;font-size:clamp(58px,9vw,150px);line-height:.88;letter-spacing:-.025em">Lições de <em style="font-weight:300;color:#B8195A">uma flor</em></h2>
      <p style="margin:.7em 0 0;font-style:italic;font-size:clamp(23px,2.3vw,32px);line-height:1.25">Se pudéssemos ouvi-las, o que elas teriam a nos dizer?</p>
    </div>
    <div data-r="" style="flex:1 1 340px;max-width:34em;opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 40px))">
      <p style="margin:0 0 .9em">As flores sempre despertaram algo em nós.</p>
      <p style="margin:0 0 .9em">Mas o que exatamente acontece quando ficamos diante delas?</p>
      <p style="margin:0 0 .9em">Talvez a resposta passe pelos sentidos, pelas emoções, pela memória, pela atenção, pelo cuidado e também pela nossa capacidade de encontrar significado e encantamento nas coisas simples.</p>
      <p style="margin:0 0 .9em">Em outras palavras: <b>o que uma flor pode revelar sobre a nossa própria interioridade?</b></p>
      <p style="margin:0">Talvez refletir sobre essa pergunta seja também uma forma de nos aproximarmos de um viver com mais Esmero.</p>
    </div>
  </div>
</section>

<section data-scene="track" aria-label="Lições de uma flor" style="position:relative;height:var(--h-track,640vh)">
  <div style="position:sticky;top:0;height:100svh;overflow:hidden;display:flex;flex-direction:column;box-sizing:border-box;padding-top:80px">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 clamp(20px,5vw,72px) 10px">
      <div style="display:flex;align-items:baseline;gap:14px;flex-wrap:wrap">
        <span style="font-family:'Architects Daughter',cursive;font-size:13px;letter-spacing:.14em;text-transform:uppercase">Lições de uma flor:</span>
        <span style="font-style:italic;font-size:24px;color:#B8195A">Número <span data-count="">01</span></span>
      </div>
      <div style="display:flex;align-items:center;gap:14px">
        <div class="nao-celular" style="display:flex;gap:7px;align-items:center">
            {licoes.map(() => <span data-ind="" style="width:8px;height:8px;border-radius:60% 40% 55% 45%;background:#1F1A17;opacity:.25;transition:all .5s" />)}
          </div>
        <button data-tarde="" class="hv-2" type="button" data-go="-1" aria-label="Lição anterior" style="position:relative;width:50px;height:50px;border:0;border-radius:50%;background:url('/aquarela/lavanda.webp') center/0% 0% no-repeat;color:#1F1A17;cursor:pointer;display:grid;place-items:center;transition:background-size .7s"><svg viewBox="0 0 50 50" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible"><path d="M25 2 C 40 2, 48 12, 48 25 C 48 40, 38 48, 24 48 C 10 48, 2 38, 2 25 C 2 12, 12 3, 28 3" fill="none" stroke="#1F1A17" stroke-width="1.3" filter="url(#ink)"></path></svg><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M15 5 C 12 8, 10 10, 8 12 C 10 14, 12 16, 15 19"></path></svg></button>
        <button data-tarde="" class="hv-3" type="button" data-go="1" aria-label="Próxima lição" style="position:relative;width:50px;height:50px;border:0;border-radius:50%;background:url('/aquarela/pincelada.webp') center/0% 0% no-repeat;color:#1F1A17;cursor:pointer;display:grid;place-items:center;transition:background-size .7s"><svg viewBox="0 0 50 50" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible"><path d="M25 2 C 40 2, 48 12, 48 25 C 48 40, 38 48, 24 48 C 10 48, 2 38, 2 25 C 2 12, 12 3, 28 3" fill="none" stroke="#1F1A17" stroke-width="1.3" filter="url(#ink)"></path></svg><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9 5 C 12 8, 14 10, 16 12 C 14 14, 12 16, 9 19"></path></svg></button>
      </div>
    </div>
    <div data-track="" style="flex:1;display:flex;gap:clamp(22px,3vw,44px);align-items:center;padding:0 clamp(20px,5vw,72px);will-change:transform">
      {licoes.map((l) => <CartaoLicao licao={l} />)}
      <div aria-hidden="true" style="flex:none;width:clamp(4px,3vw,40px);height:1px"></div>
    </div>
  </div>
</section>
