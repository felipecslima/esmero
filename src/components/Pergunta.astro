      <img src="/aquarela/terracota.png" alt="" style="position:absolute;left:20%;top:52%;width:22%;height:8%;object-fit:fill;opacity:var(--p3,0)">
      <img src="/aquarela/terracota.png" alt="" style="position:absolute;left:56%;top:52%;width:22%;height:8%;object-fit:fill;opacity:var(--p3,0)">
      <img src="/aquarela/coral.png" alt="" style="position:absolute;left:4%;top:28%;width:92%;opacity:var(--p3,0);transform:scale(calc(.3 + .7 * var(--p3,0)));transform-origin:50% 90%">
