      <svg viewBox="0 0 500 600" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible">
        <g data-sd="" data-a="0" data-b="0.75" filter="url(#ink)" fill="none" stroke="#1F1A17" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path pathLength="1" stroke-dasharray="1" d="M150 90 h200 v290 h-200 Z"></path>
