<section id="esmero" data-scene="pergunta" style="position:relative;height:var(--h-perg,280vh)">
  <div style="position:sticky;top:0;height:100svh;overflow:hidden">
    <div style="position:absolute;right:clamp(-40px,3vw,80px);bottom:2vh;height:min(82vh,120vw);aspect-ratio:5/6;opacity:var(--balc-o,.95)">
