---

---
<section data-scene="banda" aria-labelledby="h-banda" style="position:relative;height:var(--h-banda,220vh)">
  <div style="position:sticky;top:0;height:100svh;overflow:hidden;display:grid;place-items:center;text-align:center">
    <div aria-hidden="true" style="position:absolute;left:-4%;right:-4%;top:12%;height:38%;background:url('/aquarela/pincelada.png') center/100% 100% no-repeat;clip-path:inset(0 calc((1 - var(--p1,0)) * 100%) 0 0);transform:rotate(-4deg) scaleY(1.6)"></div>
    <div aria-hidden="true" style="position:absolute;left:-4%;right:-4%;bottom:10%;height:36%;background:url('/aquarela/pincelada-lavanda.png') center/100% 100% no-repeat;clip-path:inset(0 0 0 calc((1 - var(--p2,0)) * 100%));transform:rotate(3deg) scaleY(1.6) scaleX(-1)"></div>
    <div style="position:relative;padding:0 clamp(20px,5vw,72px)">
      <span aria-hidden="true" style="display:block;font-family:'Ms Madi',cursive;font-size:clamp(120px,18vw,260px);line-height:.75;color:#1F1A17;clip-path:inset(-30% calc((1 - var(--p2,0)) * 100%) -30% 0)">02</span>
      <h2 id="h-banda" style="margin:.6em 0 0;font-family:'Architects Daughter',cursive;font-weight:400;font-size:clamp(18px,2.4vw,34px);letter-spacing:.14em;text-transform:uppercase;line-height:1.4;text-wrap:balance;opacity:var(--p2,0);transform:translateY(calc((1 - var(--p2,0)) * 40px))">Sentir o mundo &amp; criar com ESMERO</h2>
      <p style="margin:.3em 0 0;font-style:italic;font-size:clamp(26px,3vw,44px);opacity:var(--p3,0);transform:translateY(calc((1 - var(--p3,0)) * 40px))">maneiras mais belas de estar aqui.</p>
    </div>
  </div>
</section>
