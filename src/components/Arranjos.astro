---
import Contorno from './ui/Contorno.astro';
import Seta from './ui/Seta.astro';
import { links } from '../config';
---
<section id="arranjos" style="position:relative;z-index:2;background:#F3EDE2 url('/aquarela/papel.webp');padding:clamp(80px,10vw,150px) clamp(20px,5vw,72px) clamp(90px,10vw,150px);scroll-margin-top:40px">
  <svg viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;left:0;top:-60px;width:100%;height:80px;overflow:visible"><path d="M0 80 L0 46 C 200 22, 420 60, 720 34 S 1240 18, 1440 44 L1440 80 Z" fill="#F3EDE2" filter="url(#rough)"></path></svg>
  <div style="max-width:1320px;margin:0 auto">
    <div data-r="" style="display:flex;flex-wrap:wrap;gap:12px 22px;align-items:center;margin-bottom:clamp(24px,3vw,40px);opacity:var(--r,1)">
      <span style="font-family:'Architects Daughter',cursive;font-size:13px;letter-spacing:.14em;text-transform:uppercase">[ Edições por temporada ]</span>
      <span style="position:relative;padding:8px 18px;font-family:'Architects Daughter',cursive;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:#B8195A">Primeira coleção · 22.09.2026<svg viewBox="0 0 200 50" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible"><path d="M100 3 C 160 2, 198 12, 197 26 C 196 42, 150 48, 98 47 C 40 46, 3 40, 4 24 C 5 10, 50 2, 112 6" fill="none" stroke="#D6246E" stroke-width="1.3" vector-effect="non-scaling-stroke" filter="url(#ink)"></path></svg></span>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:clamp(28px,5vw,90px);align-items:flex-end">
      <h2 data-r="" style="flex:1 1 560px;margin:0;font-weight:400;font-size:clamp(58px,10vw,168px);line-height:.88;letter-spacing:-.025em">
        <span style="display:block;transform:translateY(calc((1 - var(--r,1)) * 60px));opacity:var(--r,1)">Arranjos florais</span>
        <span style="display:inline-block;position:relative;font-style:italic;font-weight:300;color:#B8195A;padding-left:clamp(0px,8vw,140px);transform:translateY(calc((1 - var(--r,1)) * 110px));opacity:var(--r,1)"><img loading="lazy" decoding="async" src="/aquarela/lavanda.webp" alt="" style="position:absolute;left:clamp(0px,6vw,110px);top:10%;width:calc(100% - clamp(0px,4vw,60px));z-index:-1;opacity:.75;transform:scale(calc(.4 + .6 * var(--r,1)))">autorais</span>
      </h2>
      <div data-r="" style="flex:1 1 340px;max-width:34em;opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 40px))">
        <p style="margin:0 0 1em">Uma coleção semanal de arranjos florais autorais. Um exercício de curadoria, criatividade e sensibilidade para o nosso bem-viver.</p>
        <p style="margin:0 0 1em">A cada semana, ao menos três composições são divulgadas em nossas redes para você escolher seu exemplar preferido.</p>
        <p style="margin:0">Disponíveis sob demanda, enquanto durar a edição. Exclusivo em Belém do Pará.</p>
        <div style="margin-top:1.8em"><a class="hv-1" href={links.semana} target="_blank" rel="noopener" data-paint="" style="position:relative;display:inline-flex;align-items:center;gap:12px;padding:15px 26px;font-family:'Architects Daughter',cursive;font-size:14px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;color:#1F1A17;isolation:isolate;transition:letter-spacing .8s cubic-bezier(.2,.7,.2,1)"><span class="paint-ink" aria-hidden="true"></span>Quero meu arranjo da semana<Seta /><Contorno /></a></div>
      </div>
    </div>

    <div data-r="" aria-hidden="true" style="display:flex;align-items:center;gap:18px;margin-top:clamp(80px,10vw,140px);font-style:italic;font-size:clamp(19px,1.6vw,24px);color:#5A514A">
      <svg viewBox="0 0 400 10" preserveAspectRatio="none" style="flex:1;height:10px;overflow:visible"><path d="M400 5 C 300 3, 200 7, 0 4" fill="none" stroke="#1F1A17" stroke-opacity=".5" stroke-width="1.2" vector-effect="non-scaling-stroke" pathLength="1" stroke-dasharray="1" filter="url(#ink)" style="stroke-dashoffset:calc(1 - var(--r,1))"></path></svg>
      <span style="text-align:center;opacity:var(--r,1)">do pequeno gesto à criação singular</span>
      <svg viewBox="0 0 400 10" preserveAspectRatio="none" style="flex:1;height:10px;overflow:visible"><path d="M0 5 C 100 7, 200 3, 400 5" fill="none" stroke="#1F1A17" stroke-opacity=".5" stroke-width="1.2" vector-effect="non-scaling-stroke" pathLength="1" stroke-dasharray="1" filter="url(#ink)" style="stroke-dashoffset:calc(1 - var(--r,1))"></path></svg>
    </div>

    <article data-r="" style="display:flex;flex-wrap:wrap;gap:clamp(40px,7vw,120px);align-items:center;padding-block:clamp(60px,8vw,120px) clamp(40px,6vw,90px)">
      <div style="position:relative;flex:0 0 auto;width:clamp(210px,21vw,300px);margin-left:clamp(0px,7vw,110px)">
        <div class="wc wc-r" style="position:relative;aspect-ratio:3/4;overflow:hidden"><img loading="lazy" decoding="async" src="/fotos/dia-a-dia-1.webp" alt="Mão segurando um pequeno arranjo com uma gérbera rosa, folhagens e uma etiqueta ESMERO" class="wc-tint wc-tint-r" style="width:100%;height:100%;object-fit:cover;display:block;transform:scale(calc(1.15 - .15 * var(--r,1)))"></div>
        <svg viewBox="0 0 100 133" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;left:0;top:0;width:100%;aspect-ratio:3/4;height:auto;overflow:visible;pointer-events:none"><g data-sd="" filter="url(#ink)" fill="none" stroke="#1F1A17" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-linecap="round"><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M-8 0 H108 M-8 133 H108"></path><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M0 -10 V143 M100 -10 V143"></path><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" stroke-opacity=".7" d="M50 0 V133 M0 52 H100"></path><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M-12 140 H112 M-10 147 H110"></path></g></svg>
        <img loading="lazy" decoding="async" src="/aquarela/terracota.webp" alt="" style="position:absolute;left:8%;top:calc(100% + 12px);width:84%;height:70px;object-fit:fill;opacity:calc(var(--r,1) * .95)">
        <img loading="lazy" decoding="async" src="/aquarela/folhagem.webp" alt="" style="position:absolute;left:-24%;top:calc(100% - 50px);width:148%;opacity:var(--r,1);transform:scale(calc(.5 + .5 * var(--r,1)));transform-origin:50% 80%">
      </div>
      <div style="flex:1 1 300px;padding-top:40px;opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 50px))">
        <h3 style="margin:0;font-weight:400;font-style:italic;font-size:clamp(56px,7vw,104px);line-height:.88;letter-spacing:-.025em">Dia a Dia</h3>
        <p style="margin:.9em 0 0;max-width:24em;font-size:clamp(19px,1.5vw,23px)">O pequeno gesto. Espontâneo. Significativo.</p>
        <a class="hv-1" href={links.dia} target="_blank" rel="noopener" data-paint="" style="position:relative;display:inline-flex;align-items:center;gap:12px;margin-top:1.5em;padding:14px 24px;font-family:'Architects Daughter',cursive;font-size:14px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;color:#1F1A17;isolation:isolate;transition:letter-spacing .8s cubic-bezier(.2,.7,.2,1)"><span class="paint-ink" aria-hidden="true"></span>Quero um Dia a Dia<Seta /><Contorno /></a>
      </div>
    </article>

    <article data-r="" style="display:flex;flex-direction:row-reverse;flex-wrap:wrap;gap:clamp(40px,7vw,120px);align-items:center;padding-block:clamp(70px,9vw,140px)">
      <div style="position:relative;flex:0 0 auto;width:clamp(260px,32vw,460px);margin-right:clamp(0px,5vw,80px)">
        <div class="wc wc-r" style="position:relative;aspect-ratio:3/4.2;border-radius:999px 999px 0 0;overflow:hidden"><img loading="lazy" decoding="async" src="/fotos/essencial-1.webp" alt="Mão segurando um buquê com girassol, antirrinos e eucalipto em papel kraft de bolinhas" class="wc-tint wc-tint-r" style="width:100%;height:100%;object-fit:cover;display:block;transform:scale(calc(1.15 - .15 * var(--r,1)))"></div>
        <svg viewBox="0 0 100 140" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;left:0;top:0;width:100%;height:calc(100% - 0px);overflow:visible;pointer-events:none"><g data-sd="" filter="url(#ink)" fill="none" stroke="#1F1A17" stroke-width="1.5" stroke-linecap="round"><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M-5 145 L-5 50 C -5 -16, 105 -16, 105 50 L105 145"></path><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" stroke-opacity=".6" d="M50 -3 V140"></path></g></svg>
        <svg viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;left:-10%;top:calc(100% - 64px);width:120%;height:90px;overflow:visible;pointer-events:none"><g data-sd="" filter="url(#ink)" fill="none" stroke="#1F1A17" stroke-width="1.5" stroke-linecap="round"><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M0 4 H200 M0 56 H200 M-6 62 H206"></path><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M0 30 Q 7 20, 14 30 T 28 30 T 42 30 T 56 30 T 70 30 T 84 30 T 98 30 T 112 30 T 126 30 T 140 30 T 154 30 T 168 30 T 182 30 T 196 30"></path><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M2 4 V56 M30 4 V56 M58 4 V56 M86 4 V56 M114 4 V56 M142 4 V56 M170 4 V56 M198 4 V56"></path></g></svg>
        <img loading="lazy" decoding="async" src="/aquarela/coral.webp" alt="" style="position:absolute;left:-22%;top:calc(100% - 140px);width:80%;opacity:var(--r,1);transform:scale(calc(.4 + .6 * var(--r,1)));transform-origin:70% 90%">
      </div>
      <div style="flex:1 1 300px;opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 50px))">
        <h3 style="margin:0;font-weight:400;font-style:italic;font-size:clamp(64px,9vw,144px);line-height:.88;letter-spacing:-.025em">Essencial</h3>
        <p style="margin:.9em 0 0;max-width:24em;font-size:clamp(19px,1.5vw,23px)">Onde beleza, composição e naturalidade se encontram. A expressão da nossa assinatura.</p>
        <a class="hv-1" href={links.essencial} target="_blank" rel="noopener" data-paint="" style="position:relative;display:inline-flex;align-items:center;gap:12px;margin-top:1.5em;padding:14px 24px;font-family:'Architects Daughter',cursive;font-size:14px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;color:#1F1A17;isolation:isolate;transition:letter-spacing .8s cubic-bezier(.2,.7,.2,1)"><span class="paint-ink" aria-hidden="true"></span>Quero um Essencial<Seta /><Contorno /></a>
      </div>
    </article>

    <article data-r="" style="display:flex;flex-wrap:wrap;gap:clamp(40px,6vw,110px);align-items:flex-end;padding-block:clamp(70px,9vw,140px) 0">
      <div style="position:relative;flex:0 1 auto;width:clamp(300px,56vw,820px)">
        <div class="wc wc-r" style="position:relative;aspect-ratio:1/1.02"><img loading="lazy" decoding="async" src="/fotos/unique-1.webp" alt="Buquê em papel branco com girassol, antirrinos rosa e pétalas laranja espalhadas" class="wc-tint wc-tint-r" style="width:100%;height:100%;object-fit:cover;display:block;transform:scale(calc(1.2 - .2 * var(--r,1)))"></div>
        <img loading="lazy" decoding="async" src="/aquarela/buganvilia-2.webp" alt="" style="position:absolute;right:-14%;top:-12%;width:62%;opacity:var(--r,1);transform:scale(calc(.4 + .6 * var(--r,1))) rotate(calc((1 - var(--r,1)) * 20deg));transform-origin:30% 70%">
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none"><g data-sd="" filter="url(#ink)" fill="none" stroke="#1F1A17" stroke-width="1" stroke-linecap="round"><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M0 104 H100 M0 101 V107 M100 101 V107"></path><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M-4 0 V100 M-7 0 H-1 M-7 100 H-1"></path></g></svg>
      </div>
      <div style="flex:1 1 280px;opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 50px))">
        <h3 style="margin:0;font-weight:300;font-style:italic;font-size:clamp(76px,12vw,200px);line-height:.84;letter-spacing:-.03em;color:#B8195A">Unique</h3>
        <p style="margin:.9em 0 0;max-width:24em;font-size:clamp(19px,1.5vw,23px)">A criação singular. Livre para ser elegante, exuberante, minimalista ou inesperada, conforme a coleção.</p>
        <a class="hv-1" href={links.unique} target="_blank" rel="noopener" data-paint="" style="position:relative;display:inline-flex;align-items:center;gap:12px;margin-top:1.5em;padding:14px 24px;font-family:'Architects Daughter',cursive;font-size:14px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;color:#1F1A17;isolation:isolate;transition:letter-spacing .8s cubic-bezier(.2,.7,.2,1)"><span class="paint-ink" aria-hidden="true"></span>Quero um Unique<Seta /><Contorno /></a>
      </div>
    </article>

    <div data-r="" style="position:relative;margin-top:clamp(100px,12vw,180px)">
      <img loading="lazy" decoding="async" src="/aquarela/agua.webp" alt="" style="position:absolute;left:-6%;top:30px;width:112%;height:var(--agua-h,220px);object-fit:fill;opacity:.75;-webkit-mask-image:url('/aquarela/mascara-1.webp'),url('/aquarela/mascara-2.webp'),url('/aquarela/mascara-3.webp');mask-image:url('/aquarela/mascara-1.webp'),url('/aquarela/mascara-2.webp'),url('/aquarela/mascara-3.webp');-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:8% 50%,50% 50%,92% 50%;mask-position:8% 50%,50% 50%,92% 50%;-webkit-mask-size:calc(clamp(0, var(--r,1) * 2.2, 1) * 70%) 200%,calc(clamp(0, (var(--r,1) - .3) * 2.2, 1) * 70%) 200%,calc(clamp(0, (var(--r,1) - .55) * 2.3, 1) * 70%) 200%;mask-size:calc(clamp(0, var(--r,1) * 2.2, 1) * 70%) 200%,calc(clamp(0, (var(--r,1) - .3) * 2.2, 1) * 70%) 200%,calc(clamp(0, (var(--r,1) - .55) * 2.3, 1) * 70%) 200%">
      <ol aria-label="Como funciona" style="position:relative;list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:clamp(28px,4vw,64px)">
        <li style="flex:1 1 240px;opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 40px))">
          <div style="position:relative;width:190px;height:110px;display:grid;place-items:center"><img loading="lazy" decoding="async" src="/aquarela/pedra.webp" alt="" style="position:absolute;inset:0;width:100%;height:100%"><svg viewBox="0 0 200 110" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible"><path d="M20 60 C 18 30, 60 12, 110 14 C 160 16, 190 34, 186 62 C 182 90, 140 102, 96 100 C 50 98, 22 88, 20 60 Z" fill="none" stroke="#1F1A17" stroke-width="1.5" filter="url(#ink)"></path></svg><span style="position:relative;font-style:italic;font-size:52px;line-height:1;color:#B8195A">1</span></div>
          <h3 style="margin:.9em 0 .4em;font-family:'Architects Daughter',cursive;font-weight:400;font-size:15px;letter-spacing:.14em;text-transform:uppercase">Acompanhe</h3>
          <p style="margin:0;max-width:20em">A cada semana, ao menos três composições são divulgadas em nossas redes.</p>
        </li>
        <li style="flex:1 1 240px;padding-top:clamp(0px,3vw,46px);opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 80px))">
          <div style="position:relative;width:190px;height:110px;display:grid;place-items:center"><img loading="lazy" decoding="async" src="/aquarela/pedra.webp" alt="" style="position:absolute;inset:0;width:100%;height:100%;transform:scaleX(-1)"><svg viewBox="0 0 200 110" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible"><path d="M16 54 C 20 24, 70 10, 120 16 C 170 22, 192 44, 182 70 C 172 96, 120 104, 80 98 C 36 92, 12 80, 16 54 Z" fill="none" stroke="#1F1A17" stroke-width="1.5" filter="url(#ink)"></path></svg><span style="position:relative;font-style:italic;font-size:52px;line-height:1;color:#B8195A">2</span></div>
          <h3 style="margin:.9em 0 .4em;font-family:'Architects Daughter',cursive;font-weight:400;font-size:15px;letter-spacing:.14em;text-transform:uppercase">Escolha</h3>
          <p style="margin:0;max-width:20em">Para você escolher seu exemplar preferido.</p>
        </li>
        <li style="flex:1 1 240px;padding-top:clamp(0px,6vw,92px);opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 120px))">
          <div style="position:relative;width:190px;height:110px;display:grid;place-items:center"><img loading="lazy" decoding="async" src="/aquarela/pedra.webp" alt="" style="position:absolute;inset:0;width:100%;height:100%"><svg viewBox="0 0 200 110" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible"><path d="M24 62 C 14 36, 54 14, 104 12 C 154 10, 192 30, 188 58 C 184 88, 146 100, 100 102 C 56 104, 30 86, 24 62 Z" fill="none" stroke="#1F1A17" stroke-width="1.5" filter="url(#ink)"></path></svg><span style="position:relative;font-style:italic;font-size:52px;line-height:1;color:#B8195A">3</span></div>
          <h3 style="margin:.9em 0 .4em;font-family:'Architects Daughter',cursive;font-weight:400;font-size:15px;letter-spacing:.14em;text-transform:uppercase">Peça</h3>
          <p style="margin:0;max-width:20em">Disponíveis sob demanda, enquanto durar a edição. Exclusivo em Belém do Pará.</p>
        </li>
      </ol>
    </div>
  </div>
</section>
