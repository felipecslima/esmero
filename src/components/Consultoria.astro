---
import Contorno from './ui/Contorno.astro';
import Seta from './ui/Seta.astro';
import { links } from '../config';
---
<section id="consultoria" aria-labelledby="h-cons" style="padding:clamp(90px,12vw,180px) clamp(20px,5vw,72px);max-width:1360px;margin:0 auto;display:flex;flex-wrap:wrap;gap:clamp(40px,7vw,120px);align-items:flex-start;scroll-margin-top:40px">
  <div style="flex:1 1 480px;position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.66fr);gap:clamp(18px,2.4vw,34px)">
    <figure data-r="" data-par="" style="grid-column:1 / 3;position:relative;margin:0">
      <img src="/aquarela/folhagem.png" alt="" style="position:absolute;right:-8%;top:-22%;width:48%;opacity:var(--r,1);transform:translateY(calc(var(--c,0) * 40px)) scale(calc(.5 + .5 * var(--r,1)))">
      <div class="wc wc-r" style="position:relative;aspect-ratio:16/10;overflow:hidden"><img src="/fotos/interior-sala.jpg" alt="Sala de estar clara com sofá curvo, planta e luz natural" class="wc-tint wc-tint-r" style="width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.15) translateY(calc(var(--c,0) * -5%))"></div>
      <svg viewBox="0 0 100 62.5" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none"><g data-sd="" filter="url(#ink)" fill="none" stroke="#1F1A17" stroke-width="1.3" stroke-linecap="round"><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M-4 0 H104 M-4 62.5 H104"></path><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M0 -5 V67.5 M100 -5 V67.5"></path></g></svg>
    </figure>
    <figure data-r="" data-par="" style="position:relative;margin:0">
      <img src="/aquarela/lavanda.png" alt="" style="position:absolute;left:-18%;bottom:-14%;width:110%;opacity:calc(var(--r,1) * .8);transform:translateY(calc(var(--c,0) * 30px))">
      <div class="wc wc-r" style="position:relative;aspect-ratio:4/5"><img src="/fotos/interior-cozinha.jpg" alt="Cozinha compacta com cantinho de refeição e armários em tom vinho" class="wc-tint wc-tint-r" style="width:100%;height:100%;object-fit:cover;display:block;transform:translateY(calc(var(--c,0) * -4%)) scale(1.1)"></div>
    </figure>
    <figure data-r="" data-par="" style="position:relative;margin:clamp(40px,7vw,110px) 0 0;transform:translateY(calc(var(--c,0) * 40px))">
      <img src="/aquarela/copa.png" alt="" style="position:absolute;left:-30%;top:-20%;width:100%;opacity:calc(var(--r,1) * .55)">
      <div class="wc wc-r" style="position:relative;aspect-ratio:3/4.4;border-radius:999px 999px 0 0;overflow:hidden"><img src="/fotos/interior-quarto.jpg" alt="Quarto aconchegante com cama de cabeceira clara, prateleiras de madeira e plantas" class="wc-tint wc-tint-r" style="width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.12)"></div>
      <svg viewBox="0 0 100 146" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none"><g data-sd="" filter="url(#ink)" fill="none" stroke="#1F1A17" stroke-width="1.3" stroke-linecap="round"><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M-4 150 L-4 50 C -4 -14, 104 -14, 104 50 L104 150"></path><path pathLength="1" stroke-dasharray="1" vector-effect="non-scaling-stroke" d="M-10 152 H110"></path></g></svg>
    </figure>
  </div>
  <div data-r="" style="flex:1 1 360px;position:sticky;top:110px;opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 50px))">
    <span aria-hidden="true" style="display:block;font-family:'Ms Madi',cursive;font-size:clamp(90px,10vw,150px);line-height:.8;color:#B8195A;margin-bottom:.1em">03</span>
    <h2 style="margin:0;font-family:'Architects Daughter',cursive;font-weight:400;font-size:clamp(16px,1.5vw,21px);letter-spacing:.12em;text-transform:uppercase;line-height:1.5">O que fazemos para você:</h2>
    <h3 id="h-cons" style="margin:.5em 0 0;font-weight:400;font-style:italic;font-size:clamp(40px,4.6vw,72px);line-height:.98;letter-spacing:-.015em;text-wrap:balance">Consultoria de Interiores para o bem-viver:</h3>
    <p style="margin:1.1em 0 0;font-size:clamp(22px,2vw,28px);line-height:1.3;max-width:26em">Para quando a casa, o escritório ou a sala de atendimento já não acompanha tão bem a vida que você leva.</p>
    <p style="margin:1.2em 0 1em;max-width:30em">Uma leitura cuidadosa do seu espaço e momento de vida para perceber, no que já existe, novas possibilidades de acolher sua rotina e aquilo que importa para você.</p>
    <p style="margin:0;max-width:30em">Construímos diretrizes para mudanças singelas de composição, organização e atmosfera: sem obras, pensadas com esmero e dentro da sua realidade.</p>
    <div style="display:flex;flex-wrap:wrap;gap:18px 26px;align-items:center;margin-top:1.8em">
      <span style="position:relative;padding:8px 16px;font-family:'Architects Daughter',cursive;font-size:13px;letter-spacing:.12em;text-transform:uppercase">Atendimento 100% online.<svg viewBox="0 0 200 50" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible"><path d="M100 3 C 160 2, 198 12, 197 26 C 196 42, 150 48, 98 47 C 40 46, 3 40, 4 24 C 5 10, 50 2, 112 6" fill="none" stroke="#8E79D6" stroke-width="1.3" vector-effect="non-scaling-stroke" filter="url(#ink)"></path></svg></span>
      <a class="hv-1" href={links.consultoria} target="_blank" rel="noopener" data-paint="" style="position:relative;display:inline-flex;align-items:center;gap:12px;padding:14px 24px;font-family:'Architects Daughter',cursive;font-size:14px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;color:#1F1A17;isolation:isolate;transition:letter-spacing .8s cubic-bezier(.2,.7,.2,1)"><span aria-hidden="true" style="position:absolute;inset:-10px -16px;z-index:-1;pointer-events:none;opacity:var(--fade,1);background-image:url('/aquarela/pincelada-lavanda.png'),url('/aquarela/pincelada-lavanda.png'),url('/aquarela/buganvilia-2.png');background-repeat:no-repeat;background-position:left 46%,right 64%,78% 40%;background-size:calc(clamp(0, var(--paint,0) * 1.35, 1) * 108%) 330%,calc(clamp(0, (var(--paint,0) - .28) * 1.7, 1) * 92%) 240%,calc(clamp(0, (var(--paint,0) - .55) * 2.2, 1) * 46%) 130%"></span>Quero saber mais<Seta /><Contorno /></a>
    </div>
  </div>
</section>
