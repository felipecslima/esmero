---
import Contorno from './ui/Contorno.astro';
import Seta from './ui/Seta.astro';
import { links } from '../config';
---
<section aria-label="Contato" style="padding:clamp(140px,15vw,220px) clamp(20px,5vw,72px) 0;max-width:1360px;margin:0 auto">
  <p data-r="" data-words="" style="position:relative;z-index:1;margin:0;font-size:clamp(46px,7.4vw,124px);line-height:.95;letter-spacing:-.022em;max-width:12.5em;text-wrap:balance"><span data-w="">Quando</span> <span data-w="">o</span> <span data-w="">interior</span> <span data-w="">faz</span> <span data-w="">sentido,</span> <span data-w="">o</span> <span data-w="">bem</span> <span data-w="">viver</span> <span data-w="">ganha</span> <span data-w="">espaço</span> <span data-w="">para</span> <em data-w="" style="color:#B8195A;font-weight:300">florescer.</em></p>
  <div data-r="" style="position:relative;height:calc(min(64vw,560px) * 1.25 + 100px);margin-top:clamp(20px,3vw,40px)">
    <div style="position:absolute;left:50%;bottom:80px;width:min(64vw,560px);aspect-ratio:1200/1500;transform:translateX(-36%)">
      <img class="wc wc-r" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-svg="copa" data-prog="--r" alt="" style="position:absolute;left:0;top:0;width:100%;opacity:var(--r,1);transform:scale(calc(0.74 + 0.26 * var(--r,1)));transform-origin:50% 100%">
      <svg viewBox="0 0 1200 1500" aria-hidden="true" style="position:absolute;inset:0;width:100%;height:100%;overflow:visible"><g data-sd="" filter="url(#ink)" fill="none" stroke="#1F1A17" stroke-width="5" stroke-linecap="round"><path pathLength="1" stroke-dasharray="1" d="M600 1500 C 596 1300, 610 1100, 590 900 C 580 800, 600 720, 640 640"></path><path pathLength="1" stroke-dasharray="1" stroke-width="3" d="M594 1000 C 520 920, 440 880, 380 840 M600 900 C 680 840, 740 800, 820 780 M590 820 C 560 760, 520 720, 470 690"></path></g></svg>
    </div>
    <svg viewBox="0 0 1440 20" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;left:-5vw;right:-5vw;bottom:72px;width:110vw;max-width:none;height:20px;overflow:visible"><g data-sd="" filter="url(#ink)" fill="none" stroke-linecap="round"><path pathLength="1" stroke-dasharray="1" stroke="#E7B422" stroke-width="6" vector-effect="non-scaling-stroke" d="M0 10 C 300 8, 700 12, 1000 9 S 1300 11, 1440 10"></path></g></svg>
    <img src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-svg="copa" data-prog="--r" alt="" style="position:absolute;left:50%;top:calc(100% - 66px);width:min(64vw,560px);height:60px;object-fit:fill;transform:translateX(-36%) scaleY(-1);opacity:calc(var(--r,1) * .12);filter:blur(4px)">
  </div>
  <div data-r="" style="display:flex;flex-wrap:wrap;gap:20px 32px;align-items:center;justify-content:center;opacity:var(--r,1);transform:translateY(calc((1 - var(--r,1)) * 30px))">
    <a class="hv-1" href={links.semana} target="_blank" rel="noopener" data-paint="" style="position:relative;display:inline-flex;align-items:center;gap:12px;padding:15px 26px;font-family:'Architects Daughter',cursive;font-size:14px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none;color:#1F1A17;isolation:isolate;transition:letter-spacing .8s cubic-bezier(.2,.7,.2,1)"><span class="paint-ink" aria-hidden="true"><i></i><i></i><i></i></span>Quero meu arranjo da semana<Seta /><Contorno /></a>
    <a href="mailto:quantoesmero@gmail.com" style="text-decoration:none;font-size:21px">quantoesmero@gmail.com</a>
    <a href="https://www.instagram.com/porjulianacorrea" target="_blank" rel="noopener" style="text-decoration:none;font-size:21px">@porjulianacorrea</a>
  </div>
</section>
