---
import Contorno from './ui/Contorno.astro';
import { links } from '../config';
---
<header style="position:fixed;top:0;left:0;right:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:12px clamp(16px,4vw,56px);background:rgba(243,237,226,.95)">
  <a href="#topo" style="display:flex;align-items:center;gap:clamp(10px,1.2vw,16px);text-decoration:none;color:#1F1A17;min-width:0">
    <span style="font-family:'Ms Madi',cursive;font-size:clamp(26px,2.4vw,36px);line-height:1;white-space:nowrap;color:#1F1A17">Por Juliana Corrêa</span>
    <span style="width:1.5px;height:clamp(24px,2.2vw,32px);background:#1F1A17;flex:none"></span>
    <span style="font-weight:700;letter-spacing:.02em;font-size:clamp(18px,1.6vw,24px)">ESMERO</span>
  </a>
  <nav style="display:flex;align-items:center;gap:clamp(16px,2.2vw,32px)">
    <div class="so-largo" style="display:flex;gap:clamp(16px,2.2vw,30px)">
        <a href="#arranjos" style="font-family:'Architects Daughter',cursive;font-size:13px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none">Arranjos</a>
        <a href="#consultoria" style="font-family:'Architects Daughter',cursive;font-size:13px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none">Consultoria</a>
        <a href="#licoes" style="font-family:'Architects Daughter',cursive;font-size:13px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none">Lições de uma flor</a>
        <a href="#juliana" style="font-family:'Architects Daughter',cursive;font-size:13px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none">Juliana</a>
      </div>
    <a class="nao-celular hv-0" href={links.semana} target="_blank" rel="noopener" data-paint="" style="position:relative;display:inline-flex;align-items:center;padding:10px 18px;font-family:'Architects Daughter',cursive;font-size:13px;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;color:#1F1A17;isolation:isolate;transition:letter-spacing .8s cubic-bezier(.2,.7,.2,1)"><span class="paint-ink" aria-hidden="true"><i></i><i></i><i></i></span>Arranjo da semana<Contorno largura={1.3} /></a>
  </nav>
  <svg viewBox="0 0 1440 8" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;left:0;right:0;bottom:-4px;width:100%;height:8px;overflow:visible"><path d="M0 4 C 300 2, 700 6, 1000 3 S 1300 5, 1440 3" fill="none" stroke="#1F1A17" stroke-opacity=".5" stroke-width="1" vector-effect="non-scaling-stroke" filter="url(#ink)"></path></svg>
</header>
